.title Global shutter discrete camera
.subckt pixel pd vr rst refgate siggate sel br bs ci=100p ch=1n rl=1e12 dark=2p vos=100u

Dphoto 0 pd silicon
Cjunction pd 0 4p
Cintegration pd 0 {ci}
Rintegration pd 0 10T
Idark pd 0 {dark}
Ibias pd 0 0.2p
Sreset pd vr rst 0 gate
Bfollower buf 0 V=max(0.02,min(v(vdd)-0.02,v(pd)+vos))
Rout buf drive 50

Shr drive hr refgate 0 gate
Chr hr 0 {ch}
Rhr hr 0 {rl}
Ihr hr 0 0.2p
Ehr sourcehr 0 hr 0 1
Routhr sourcehr pinhr 50
Sreadhr pinhr br sel 0 gate

Shs drive hs siggate 0 gate
Chs hs 0 {ch}
Rhs hs 0 {rl}
Ihs hs 0 0.2p
Ehs sourcehs 0 hs 0 1
Rouths sourcehs pinhs 50
Sreadhs pinhs bs sel 0 gate

.ends pixel

.subckt amp plus minus out

* Dominant pole, 4 MHz GBW, 100k DC gain, 4 V/us slew, rail clamps
Bgm 0 pole I=max(-400u,min(400u,2.513m*(v(plus,minus)+20u)))
Rp pole 0 39.79meg
Cp pole 0 100p
Brails pole 0 I=(min(0,v(pole)-0.02)+max(0,v(pole)-v(vdd)+0.02))/2
Ebuf drive 0 pole 0 1
Rout drive out 10

.ends amp
Vdd vdd 0 5.0
Vr vr 0 3.0
